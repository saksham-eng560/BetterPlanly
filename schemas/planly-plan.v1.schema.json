{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saksham-eng560/BetterPlanly/schemas/planly-plan.v1.schema.json",
  "title": "Planly plan file v1",
  "description": "A list of tasks any AI agent can generate and Planly can import.",
  "type": "object",
  "required": [
    "planly",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "planly": {
      "const": "1",
      "description": "Format version."
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "tasks": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 200,
          "description": "Stable id within this plan. Re-importing a task with the same id updates it instead of duplicating it."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "type": {
          "type": "string",
          "enum": [
            "study",
            "work",
            "reading",
            "fitness",
            "meeting",
            "habit",
            "errand",
            "personal",
            "other"
          ],
          "default": "other"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "YYYY-MM-DD. Omit for Unscheduled."
        },
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "HH:MM, 24-hour, local time. Omit for Anytime."
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "description": "Minutes."
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "default": "medium"
        },
        "status": {
          "type": "string",
          "enum": [
            "todo",
            "done",
            "skipped"
          ],
          "default": "todo"
        },
        "notes": {
          "type": "string",
          "maxLength": 20000
        },
        "section": {
          "type": "string",
          "maxLength": 100,
          "description": "Group the task belongs to, e.g. a heading in the source page. Shown as one widget box per section."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "maxItems": 20
        },
        "checklist": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              {
                "type": "object",
                "required": [
                  "title"
                ],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "done": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            ]
          }
        },
        "resources": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2000
              },
              "kind": {
                "type": "string",
                "enum": [
                  "link",
                  "video",
                  "article",
                  "book",
                  "doc",
                  "note"
                ],
                "default": "link"
              },
              "note": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      }
    }
  }
}
