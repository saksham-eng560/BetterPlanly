DATABASE_URL=postgresql://planly:planly@localhost:5432/planly
OLLAMA_BASE_URL=http://localhost:11434
# Pin a model (default qwen2.5:14b); `PLANLY_MODEL=qwen2.5:7b make start` also saves it here
# OLLAMA_MODEL=qwen2.5:14b
# Context window in tokens; the agent prompt alone is ~1.7k before conversation history
OLLAMA_NUM_CTX=8192
# Notion integration token (https://www.notion.so/my-integrations); leave empty to disable sync
NOTION_TOKEN=
# Let the agent search the web (DuckDuckGo) when finding resources
WEB_SEARCH_ENABLED=false
